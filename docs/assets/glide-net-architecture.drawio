        <mxCell id="msdef" value="<b>MSDEF 解码器</b><br/><br/><span style='font-size:11px'>stage1: x3 ← WD(x2,x3,x4)<br/>stage2: x2 ← WD(x1,x2,x3)<br/>stage3: x1 ← WD(x1,x2)</span><br/><br/><span style='font-size:11px'>DEU = SA ⊙ CA ⊙ x + LFP<br/>WD = Softmax(MLP(GAP(concat)))</span>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#241A1B;strokeColor=#E5484D;fontColor=#FFD9DB;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;arcSize=6;" vertex="1" parent="1"><mxGeometry x="990" y="108" width="250" height="300" as="geometry" /></mxCell>
